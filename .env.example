# =============================================================================
# Nexo configuration — example template
# =============================================================================
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is gitignored; this file is committed so the required vars are visible.

# -----------------------------------------------------------------------------
# Model — any OpenAI-compatible endpoint works.
# -----------------------------------------------------------------------------
# provider-prefixed model name (pydantic-ai format: <provider>:<model>)
NEXO_MODEL=openai-chat:deepseek-v4-flash

# credentials for the OpenAI-compatible provider (consumed by pydantic-ai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com

# DeepSeek uses the OpenAI-compatible endpoint above — put your DeepSeek API
# key in OPENAI_API_KEY. To switch to ZhipuAI (GLM) instead, set:
#   NEXO_MODEL=openai-chat:glm-4.6
#   OPENAI_API_KEY=<your zhipu key>
#   OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# -----------------------------------------------------------------------------
# WeCom (企业微信) AI bot — credentials from the WeCom admin backend.
# The SDK connects out to wss://openws.work.weixin.qq.com using these.
# -----------------------------------------------------------------------------
WECHAT_BOT_ID=
WECHAT_BOT_SECRET=

# WeCom file/image download HTTP timeout, milliseconds. The SDK's 10s default is
# too tight for slow links; the download is a direct GET that ignores HTTP(S)_PROXY.
WECOM_REQUEST_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# 远程上传目标 — 用户上传的文件/图片/视频通过 scp 发到这台远程机器的指定文件夹。
# nexo 调用 scripts/ship_media.sh 完成投递。填必填三项；缺失时首次上传会抛清晰报错。
# 准备步骤：
#   1. 远程机上创建好接收目录（如 /data/nexo-uploads），并确保登录用户可写。
#   2. ssh-copy-id <NEXO_UPLOAD_USER>@<NEXO_UPLOAD_HOST>  配好免密登录。
#   3. 生成一对密钥，私钥放到 ./secrets/nexo_upload_key 并 chmod 600
#      （docker-compose 已将其只读挂载到 /home/app/.ssh/nexo_upload_key）。
# -----------------------------------------------------------------------------
NEXO_UPLOAD_HOST=
NEXO_UPLOAD_USER=
NEXO_UPLOAD_DIR=/data/nexo-uploads
NEXO_UPLOAD_SSH_KEY=/home/app/.ssh/nexo_upload_key
NEXO_UPLOAD_SSH_PORT=

# -----------------------------------------------------------------------------
# Observability — Langfuse (LLM tracing)
# -----------------------------------------------------------------------------
# Tracing is enabled only when both keys are set. With neither set, tracing is
# disabled and the bot runs normally (local dev). Get keys from your Langfuse
# project: UI → Settings → API Keys.
#   - Cloud:        https://cloud.langfuse.com (🇪🇺 EU), us.cloud.langfuse.com (🇺🇸),
#                   jp.cloud.langfuse.com (🇯🇵), hipaa.cloud.langfuse.com
#   - Self-hosted:  your own Langfuse URL
#                   e.g. http://10.13.11.7:3000 (the self-hosted stack in
#                   docker-compose.langfuse.yml)
# If you proxy external traffic (HTTP(S)_PROXY) but self-host Langfuse on the
# LAN, a private-IP LANGFUSE_BASE_URL is auto-added to NO_PROXY so the bot
# reaches it directly. For a *public* Langfuse host reached through a proxy,
# manage NO_PROXY yourself.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
