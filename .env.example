# =============================================================================
# Nexo configuration — example template
# =============================================================================
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is gitignored; this file is committed so the required vars are visible.

# -----------------------------------------------------------------------------
# Model — any OpenAI-compatible endpoint works.
# -----------------------------------------------------------------------------
# provider-prefixed model name (pydantic-ai format: <provider>:<model>)
NEXO_MODEL=openai-chat:deepseek-v4-flash

# credentials for the OpenAI-compatible provider (consumed by pydantic-ai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com

# DeepSeek uses the OpenAI-compatible endpoint above — put your DeepSeek API
# key in OPENAI_API_KEY. To switch to ZhipuAI (GLM) instead, set:
#   NEXO_MODEL=openai-chat:glm-4.6
#   OPENAI_API_KEY=<your zhipu key>
#   OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# -----------------------------------------------------------------------------
# WeCom (企业微信) AI bot — credentials from the WeCom admin backend.
# The SDK connects out to wss://openws.work.weixin.qq.com using these.
# -----------------------------------------------------------------------------
WECHAT_BOT_ID=
WECHAT_BOT_SECRET=

# 用户所属组织 ID。媒体归档到华为云 OBS 时对象 key 形如
# <NEXO_ORG_ID>/<user_id>/<msg_id>-<name>；富事件也带 org_id 供多 org 共库区分。
NEXO_ORG_ID=

# WeCom file/image download HTTP timeout, milliseconds. The SDK's 10s default is
# too tight for slow links; the download is a direct GET that ignores HTTP(S)_PROXY.
WECOM_REQUEST_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# 媒体归档 — 收到的文件/图片/视频由 `nexo drain` 上传到华为云 OBS 桶。
# bot 收到媒体后立即下载（URL 新鲜）写入暂存目录，并把意图写进 outbox；
# drain 从 outbox 读暂存字节上传 OBS、publish 富事件、删暂存。
# OBS_ENDPOINT 为区域端点（如 obs.cn-south-1.myhuaweicloud.com），不含 bucket 名。
# -----------------------------------------------------------------------------
OBS_ACCESS_KEY_ID=
OBS_SECRET_ACCESS_KEY=
OBS_ENDPOINT=
OBS_BUCKET=

# 暂存目录（bot 写、drain 读删）与 outbox SQLite 路径。默认 data/staging、data/outbox.db。
NEXO_STAGING_DIR=
NEXO_OUTBOX_PATH=

# media 简短回执文案（运维可配）。bot 收到媒体后回这一句；text 仍走内联 LLM 流式。
NEXO_MEDIA_ACK_TEXT=已收到，归档中

# -----------------------------------------------------------------------------
# Observability — Langfuse (LLM tracing)
# -----------------------------------------------------------------------------
# Tracing is enabled only when both keys are set. With neither set, tracing is
# disabled and the bot runs normally (local dev). Get keys from your Langfuse
# project: UI → Settings → API Keys.
#   - Cloud:        https://cloud.langfuse.com (🇪🇺 EU), us.cloud.langfuse.com (🇺🇸),
#                   jp.cloud.langfuse.com (🇯🇵), hipaa.cloud.langfuse.com
#   - Self-hosted:  your own Langfuse URL
#                   e.g. http://10.13.11.7:3000 (the self-hosted stack in
#                   docker-compose.langfuse.yml)
# If you proxy external traffic (HTTP(S)_PROXY) but self-host Langfuse on the
# LAN, a private-IP LANGFUSE_BASE_URL is auto-added to NO_PROXY so the bot
# reaches it directly. For a *public* Langfuse host reached through a proxy,
# manage NO_PROXY yourself.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# -----------------------------------------------------------------------------
# NATS JetStream — `nexo drain` 把富事件（帧 + 回复/obs_key/org/bot_id）发布到
# JetStream 流，`nexo archive` 消费者拉取并写入 MySQL。drain 与 archive 协议不同，
# NATS_URL 配置也不同：
#   - drain 用 js.publish（普通 subject + $JS.ACK 回执，不走 $JS.API）→ 可连本地
#     leaf（127.0.0.1:4222，见 scripts/nats/leaf.conf），leaf 桥接到核心集群。
#   - archive 用 pull_subscribe/fetch（走 $JS.API 管理 API）→ 无 JS 的 leaf 不透传
#     $JS.API，archive 须直连核心节点（如 nats://10.13.11.7:4222），不要经 leaf。
# 默认 NATS_URL=127.0.0.1:4222 适用 bot/drain 主机；archive 主机请改填核心节点。
# NATS_STREAM / NATS_SUBJECT_PREFIX 需与 `scripts/nats/create_stream.sh` 一致
# （默认 WECOM_MSG / nexo.wecom.msg）；stream 由该脚本在核心节点预建一次，
# NATS_ARCHIVE_DURABLE durable consumer 由 `nexo archive` 运行时自动建。
# -----------------------------------------------------------------------------
NATS_URL=nats://127.0.0.1:4222
NATS_STREAM=WECOM_MSG
NATS_SUBJECT_PREFIX=nexo.wecom.msg
NATS_ARCHIVE_DURABLE=wxcom_msg_archive

# -----------------------------------------------------------------------------
# MySQL — 仅 `nexo archive` 使用，运行在能内网连通云数据库的那台云主机上。
# 填云厂商 MySQL 的内网地址（如 172.18.12.87）。bot/drain 主机无需配置。
# -----------------------------------------------------------------------------
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
