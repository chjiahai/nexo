# =============================================================================
# Deploy profile template — copy to scripts/deploy.<profile>.env and fill in.
# =============================================================================
# scripts/deploy.<profile>.env is gitignored (it names internal hosts).
# Used by scripts/deploy.sh <profile> (rsync + docker compose; run manually —
# pushing code does not auto-deploy).
#
# Profiles (convention):
#   deploy.bot.env      → the bot+drain host (10.13.11.17, core-b)
#   deploy.archive.env  → the archive host (10.13.11.177, core-c)
#
# Usage:  bash scripts/deploy.sh bot        |   bash scripts/deploy.sh archive

# IP / hostname of the host that runs these services (has docker).
REMOTE_HOST=10.13.11.17

# SSH login user on the remote (must have docker access).
REMOTE_USER=ubuntu

# Absolute path to the nexo checkout on the remote (rsync destination).
REMOTE_PATH=/home/ubuntu/nexo

# Space-separated compose services to build + start on this host:
#   bot host:     "nexo drain"
#   archive host: "archive"
SERVICES="nexo drain"
