# =============================================================================
# Remote deploy target — copy to scripts/deploy.env and fill in.
# =============================================================================
# scripts/deploy.env is gitignored (it names an internal test host).
# Used by scripts/deploy.sh (run manually — pushing code does not auto-deploy).

# IP / hostname of the test machine that has docker + the nexo repo clone.
REMOTE_HOST=10.13.11.2

# SSH login user on the remote (must have docker access + read/write the repo).
REMOTE_USER=your-user

# Absolute path to the nexo repo clone on the remote.
REMOTE_PATH=/home/your-user/nexo

# Branch the test environment runs (the post-push hook only deploys this one).
REMOTE_BRANCH=main
