# =============================================================================
# Remote deploy target — copy to scripts/deploy.env and fill in.
# =============================================================================
# scripts/deploy.env is gitignored (it names an internal host).
# Used by scripts/deploy.sh (rsync + docker compose; run manually — pushing
# code does not auto-deploy).

# IP / hostname of the host that runs nexo bot + drain (has docker).
REMOTE_HOST=10.13.11.17

# SSH login user on the remote (must have docker access).
REMOTE_USER=ubuntu

# Absolute path to the nexo checkout on the remote (rsync destination).
REMOTE_PATH=/home/ubuntu/nexo
